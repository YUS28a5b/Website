  <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
  
  <style>
    /* ============================================================
       Personal Journal Post CSS — (컴포넌트 외 본문 전용 스타일)
    ============================================================ */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Nanum Myeongjo', serif !important;
    }

    body {
      background-color: #F7F6F2;
      color: #1A1A18;
      line-height: 1.9; 
      overflow-x: hidden;
      padding-bottom: 6rem;
    }

    /* ── Animations ── */
    .reveal {
      opacity: 0;
      animation: fadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
      will-change: transform, opacity;
    }
    
    .reveal-1 { animation-delay: 0.30s; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Post Layout ── */
    .post-article {
      max-width: 760px;
      margin: 0 auto 6rem;
      padding: 3rem 2.5rem;
      border: 1px solid #D8D6D0;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.62);
      box-shadow: 0 12px 34px rgba(26, 26, 24, 0.05);
      position: relative;
      z-index: 10;
      text-align: left; 
    }

    .post-header {
      padding-bottom: 1.25rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid #D8D6D0;
    }

    .post-meta {
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      color: #8A8880;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      text-transform: uppercase;
      margin-bottom: 1rem; 
    }

    .post-category {
      color: #1A1A18;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
    }
    
    .post-category::before {
      content: '•';
      margin-right: 0.6rem;
      color: #D8D6D0;
      font-weight: normal;
    }

    .post-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #1A1A18;
      margin: 1.5rem 0 1rem; 
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    .post-intro {
      font-size: 1.1rem;
      line-height: 1.75;
      color: #8A8880;
      margin: 0; 
    }

    .post-content {
      font-size: 1.05rem;
      line-height: 1.75; 
      color: #222;
    }

    .post-content p {
      margin: 0 0 1.5rem;
    }

    .post-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid #D8D6D0;
    }

    .back-link, .next-link {
      color: #1A1A18;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: opacity 0.3s ease;
    }

    .back-link:hover, .next-link:hover {
      opacity: 0.6;
    }

    @media (max-width: 640px) {
      .post-article { padding: 2rem 1.25rem; }
      .post-title { font-size: 1.7rem; }
      .post-content, .post-intro { font-size: 0.95rem; }
    }
  </style>
</head>
<body>

  <div id="header-placeholder"></div>

  <script>
      window.bannerConfig = {
          title: "Process Note",
          subtitle: "Traces of where I started, grew, and became myself.",
